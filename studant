<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Registration System</title>
<!-- Google Fonts & FontAwesome for modern icons -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border-color: #cbd5e1;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            --radius: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header Navigation */
        header {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #e2e8f0;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            font-size: 1.1rem;
            color: var(--primary-color);
            cursor: pointer;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .nav-link {
            text-decoration: none;
            color: var(--text-main);
            font-weight: 500;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 8px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .nav-link:hover, .nav-link.active {
            background-color: #e0e7ff;
            color: var(--primary-color);
        }

        /* Views Container */
        .main-container {
            flex: 1;
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .view-section {
            display: none;
            animation: fadeIn 0.4s ease-in-out forwards;
        }

        .view-section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* 1. Home / Welcome View Styles */
        .hero-banner {
            position: relative;
            border-radius: var(--radius);
            overflow: hidden;
            height: 320px;
            display: flex;
            align-items: center;
            padding: 40px;
            box-shadow: var(--shadow);
            margin-bottom: 40px;
        }

        .hero-banner img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        .hero-banner::after {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(90deg, rgba(15, 23, 42, 0.85) 0%, rgba(15, 23, 42, 0.4) 100%);
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            color: #ffffff;
            max-width: 600px;
        }

        .hero-content h1 {
            font-size: 2.2rem;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .hero-content p {
            color: #cbd5e1;
            font-size: 1rem;
            margin-bottom: 20px;
        }

        .action-cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            max-width: 700px;
        }

        .action-card {
            background: var(--card-bg);
            padding: 25px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #e2e8f0;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px -10px rgba(79, 70, 229, 0.15);
        }

        .action-card-info h3 {
            font-size: 1.05rem;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .action-card-info span {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Buttons Style */
        .btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 10px 22px;
            border-radius: 10px;
            font-weight: 500;
            font-size: 0.95rem;
            cursor: pointer;
            transition: background 0.3s ease, transform 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:hover {
            background-color: var(--primary-hover);
            transform: scale(1.02);
        }

        .btn-secondary {
            background-color: #334155;
        }
        .btn-secondary:hover {
            background-color: #1e293b;
        }

        /* 2. Courses View Styles */
        .section-title {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 30px;
            position: relative;
            padding-bottom: 10px;
        }

        .section-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 60px;
            height: 4px;
            background-color: var(--primary-color);
            border-radius: 2px;
        }

        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
        }

        .course-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            border: 1px solid #e2e8f0;
            transition: transform 0.3s ease;
        }

        .course-card:hover {
            transform: translateY(-5px);
        }

        .course-img-wrapper {
            height: 200px;
            overflow: hidden;
        }

        .course-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .course-card:hover .course-img-wrapper img {
            transform: scale(1.05);
        }

        .course-body {
            padding: 20px;
        }

        .course-body h3 {
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--text-main);
        }

        /* 3, 4 & 5. Forms Views (Login, Register, Forgot Password) */
        .form-card {
            background: var(--card-bg);
            max-width: 480px;
            margin: 0 auto;
            padding: 40px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid #e2e8f0;
        }

        .form-card h2 {
            font-size: 1.6rem;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .form-desc {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 25px;
        }

        .input-group {
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        .input-group input {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.3s, box-shadow 0.3s;
        }

        .input-group input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

        /* Reset Method Selector Tabs */
        .reset-methods {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .method-tab {
            flex: 1;
            padding: 10px;
            border: 1px solid var(--border-color);
            background: #f1f5f9;
            border-radius: 8px;
            text-align: center;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .method-tab.active {
            background: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

        .form-footer-link {
            display: block;
            margin-top: 15px;
            font-size: 0.85rem;
            color: var(--text-muted);
            text-align: center;
        }

        .form-footer-link a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }

        .form-footer-link a:hover {
            text-decoration: underline;
        }

        .full-width-btn {
            width: 100%;
            margin-top: 10px;
            padding: 12px;
        }

        /* Footer Info */
        footer {
            text-align: center;
            padding: 20px;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        @media (max-width: 768px) {
            header { padding: 15px 20px; }
            .hero-banner { height: auto; padding: 30px 20px; }
        }
</style>
</head>
<body>

<!-- Top Navbar -->
<header>
<div class="logo-area" onclick="switchView('home-view')">
<i class="fa-solid fa-graduation-cap"></i>
<span>Student System</span>
</div>
<nav class="nav-links">
<a class="nav-link active" onclick="switchView('home-view')"><i class="fa-solid fa-house"></i> Home</a>
<a class="nav-link" onclick="switchView('courses-view')"><i class="fa-solid fa-book-open"></i> Courses</a>
</nav>
</header>

<!-- Main Dynamic Content Views -->
<div class="main-container">

<!-- VIEW 1: Home / Entry View -->
<section id="home-view" class="view-section active">
<div class="hero-banner">
<img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=80" alt="Background Tech">
<div class="hero-content">
<h1>Student Registration System</h1>
<p>Welcome to the portal. Access your courses, manage your profile, and explore innovative academic content seamlessly.</p>
<button class="btn" onclick="switchView('courses-view')">Explore Courses <i class="fa-solid fa-arrow-right"></i></button>
</div>
</div>

<div class="action-cards-container">
<div class="action-card">
<div class="action-card-info">
<h3>Have An Account</h3>
<span>Sign in to your dashboard</span>
</div>
<button class="btn btn-secondary" onclick="switchView('login-view')">Login</button>
</div>

<div class="action-card">
<div class="action-card-info">
<h3>Create New Account</h3>
<span>Join us as a new student</span>
</div>
<button class="btn" onclick="switchView('register-view')">Create</button>
</div>
</div>
</section>

<!-- VIEW 2: Courses View -->
<section id="courses-view" class="view-section">
<h2 class="section-title">Courses</h2>
<div class="courses-grid">
<!-- Course 1 -->
<div class="course-card">
<div class="course-img-wrapper">
<img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=600&q=80" alt="Agile Project Management">
</div>
<div class="course-body">
<h3>Agile Project Management</h3>
</div>
</div>
<!-- Course 2 -->
<div class="course-card">
<div class="course-img-wrapper">
<img src="https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&w=600&q=80" alt="Artificial Intelligent">
</div>
<div class="course-body">
<h3>Artificial Intelligent</h3>
</div>
</div>
<!-- Course 3 -->
<div class="course-card">
<div class="course-img-wrapper">
<img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80" alt="Design">
</div>
<div class="course-body">
<h3>Design & UI/UX</h3>
</div>
</div>
</div>
</section>

<!-- VIEW 3: Login View -->
<section id="login-view" class="view-section">
<div class="form-card">
<h2>Login</h2>
<p class="form-desc">Please enter your credentials to access your account.</p>
<form onsubmit="handleLogin(event)">
<div class="input-group">
<label>Username</label>
<input type="text" placeholder="Enter your username" required>
</div>
<div class="input-group">
<label>Password</label>
<input type="password" placeholder="Enter your password" required>
</div>
<div style="text-align: right; margin-bottom: 20px;">
<a onclick="switchView('forgot-view')" style="font-size: 0.85rem; color: var(--primary-color); text-decoration: none; cursor: pointer;">forgot password?</a>
</div>
<button type="submit" class="btn full-width-btn">Login</button>
</form>
<div class="form-footer-link">
                    Don't have an account? <a onclick="switchView('register-view')">Create account</a>
</div>
</div>
</section>

<!-- VIEW 4: Create Account View -->
<section id="register-view" class="view-section">
<div class="form-card">
<h2>Create an Account</h2>
<p class="form-desc">Fill in the details below to register as a new student.</p>
<form onsubmit="handleRegister(event)">
<div class="input-group">
<label>Full Name</label>
<input type="text" placeholder="Enter full name" required>
</div>
<div class="input-group">
<label>Email Address</label>
<input type="email" placeholder="Enter Email" required>
</div>
<div class="input-group">
<label>Student ID</label>
<input type="text" placeholder="Enter S ID" required>
</div>
<div class="input-group">
<label>Password</label>
<input type="password" placeholder="Enter Password" required>
</div>
<div class="input-group">
<label>Confirm Password</label>
<input type="password" placeholder="Renter Password" required>
</div>
<button type="submit" class="btn full-width-btn">Create</button>
</form>
<div class="form-footer-link">
                    Already have an account? <a onclick="switchView('login-view')">Log in</a>
</div>
</div>
</section>

<!-- VIEW 5: Forgot Password View (New Addition) -->
<section id="forgot-view" class="view-section">
<div class="form-card">
<h2>Reset Password</h2>
<p class="form-desc">Choose how you want to receive your recovery code.</p>

<!-- Reset Method Selection Tabs -->
<div class="reset-methods">
<div id="tab-email" class="method-tab active" onclick="setResetMethod('email')">
<i class="fa-solid fa-envelope"></i> Via Email
</div>
<div id="tab-phone" class="method-tab" onclick="setResetMethod('phone')">
<i class="fa-solid fa-phone"></i> Via Phone Number
</div>
</div>

<form onsubmit="handleResetPassword(event)">
<!-- Email Input Group -->
<div id="group-email" class="input-group">
<label>Email Address</label>
<input type="email" id="reset-email" placeholder="Enter your registered email">
</div>

<!-- Phone Input Group (Hidden by default) -->
<div id="group-phone" class="input-group" style="display: none;">
<label>Phone Number</label>
<input type="tel" id="reset-phone" placeholder="Enter your phone number (e.g. +249...)">
</div>

<button type="submit" class="btn full-width-btn">Send Recovery Code</button>
</form>

<div class="form-footer-link">
                    Remembered your password? <a onclick="switchView('login-view')">Back to Login</a>
</div>
</div>
</section>

</div>

<!-- Footer -->
<footer>
<p>&copy; 2026 Student Registration System. All rights reserved.</p>
</footer>

<!-- JavaScript for Interactivity -->
<script>
        function switchView(viewId) {
            // Hide all sections
            const sections = document.querySelectorAll('.view-section');
            sections.forEach(section => {
                section.classList.remove('active');
            });

            // Show target section
            const targetView = document.getElementById(viewId);
            if(targetView) {
                targetView.classList.add('active');
            }

            // Update navbar active states
            const navLinks = document.querySelectorAll('.nav-link');
            navLinks.forEach(link => link.classList.remove('active'));

            // Scroll to top smoothly
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Toggle between Email and Phone reset methods
        function setResetMethod(method) {
            const tabEmail = document.getElementById('tab-email');
            const tabPhone = document.getElementById('tab-phone');
            const groupEmail = document.getElementById('group-email');
            const groupPhone = document.getElementById('group-phone');

            if (method === 'email') {
                tabEmail.classList.add('active');
                tabPhone.classList.remove('active');
                groupEmail.style.display = 'block';
                groupPhone.style.display = 'none';
                document.getElementById('reset-email').required = true;
                document.getElementById('reset-phone').required = false;
            } else {
                tabPhone.classList.add('active');
                tabEmail.classList.remove('active');
                groupPhone.style.display = 'block';
                groupEmail.style.display = 'none';
                document.getElementById('reset-phone').required = true;
                document.getElementById('reset-email').required = false;
            }
        }

        // Initialize default required state
        document.getElementById('reset-email').required = true;

        // Form Submission Handlers (Simulated)
        function handleLogin(event) {
            event.preventDefault();
            alert('Login successful! (Simulated)');
            switchView('courses-view');
        }

        function handleRegister(event) {
            event.preventDefault();
            alert('Account created successfully! (Simulated)');
            switchView('login-view');
        }

        function handleResetPassword(event) {
            event.preventDefault();
            alert('A password reset link/code has been sent successfully!');
            switchView('login-view');
        }
</script>
</body>
</html>
